"""
TVC Simulator - PID Tuning Tool
================================
Forked from fszewczyk's "TVC Simulator" project
https://github.com/fszewczyk/tvc-simulator

PID tuning simulator for the thrust-vector-controlled rocket. Runs a 2D model
once per TVC axis (pitch and yaw) with the same gains, because the firmware
flies one set of gains on both. Mirrors the firmware: the PID in src/pid.cpp
at 125 Hz with its integral clamp, nozzle limits and linkages from
include/servo_driver.h, and servos that get a new pulse every 20 ms. Also
models servo speed and delay, nozzle pointing error, attitude noise/bias, the
Estes F-15 thrust curve, propellant burn-off, drag, gravity, and altitude.

Units: the PID's output is nozzle deflection in degrees, as in the firmware.

Usage:
    python tvc_sim

Tweak the parameters in the "CONFIG" block below, then run. A matplotlib window
opens with six plots (pitch in red, yaw in blue) and the summary is printed.
Iterate on kp/ki/kd until both axes settle quickly with acceptable overshoot
and the commanded nozzle angle isn't saturating.
"""

import math
import random
import numpy as np
import matplotlib.pyplot as plt

# ============================================================================
# CONFIG - tune these
# ============================================================================

# --- PID gains (what you're tuning) ---
# One set for both axes, as in the firmware (PID_DEFAULT_* in include/pid.h).
# Units: degrees of nozzle per degree of tilt.
kp = 0.8
ki = 0.215
kd = 0.10
alpha = 0.5                         # Derivative low-pass filter (0..1, 1 = no filter).
                                    # PID_D_FILTER_ALPHA in include/pid.h — keep them equal.
integralLimit = 8.5                 # deg     PID_INTEGRAL_LIMIT in pid.h; capped per axis
                                    #         at that axis's nozzle limit, as pid_init() does

# --- Rocket physical parameters ---
# mass/MOI/lever-arms below are the LOADED (liftoff) values. Propellant
# burn-off during the flight is modeled separately below (propellantMass /
# propellantCgOffsetAftOfCOM) rather than by editing these directly.
mass = 0.775                        # kg      (liftoff mass, incl. propellant — weighed 775 g assembled with motor)
MOI = 0.014813                      # kg*m^2  (pitch/yaw MOI about the CG, liftoff — CAD Lxx/Lzz 14.81e6 g*mm^2)
# Gimbal pivot -> CoM distance (the TVC lever arm) is per axis — see AXES below.
distanceCPToCOM = 0.23547           # m       (|distance| between CP and CoM, liftoff)
                                    # No fins, so the CP is the nose cone's (Barrowman): parabolic,
                                    # 130 mm long -> CP 65 mm aft of the nose tip. Nose tip -> CG
                                    # is 300.47 mm (CAD), so CP is 235.47 mm forward of the CG.
isAerodynamicallyUnstable = True    # True = CP fwd of CoM (destabilizing), False = CP aft (stabilizing)
C_N_alpha = 2.0                     # 1/rad   (normal force slope; ~2 for slender rockets)
rocketCrossSectionalArea = 0.005352 # m^2     (pi * (82.55 mm / 2)^2, 3.25" OD airframe)
dragCoefficient = 0.45              # C_d

# Propellant burn-off: ~60 g of the F15's mass leaves during the burn, and
# it sits aft of the vehicle CG (down near the nozzle), so the combined CG
# moves forward as it depletes — this shrinks distanceCPToCOM (less
# destabilizing moment arm) and grows the TVC lever arms (more leverage)
# over the burn. propellantCgOffsetAftOfCOM is an ESTIMATE (typical motor
# placement for this airframe) — replace with a measured value from the
# mass model if/when one exists; it only scales the size of this effect,
# the direction is correct either way.
propellantMass = 0.060              # kg (Estes F15 propellant weight, certified)
propellantCgOffsetAftOfCOM = 0.15   # m  ESTIMATE — the motor sits in the gimbal, 141-183 mm aft of the CG

# --- TVC axes ---
# Nozzle deflection at full servo travel (measured 2026-11-20) and the servo
# pulse span that produces it: SERVO_*_MAX_ANGLE_DEG and SERVO_*_SPAN_US in
# include/servo_driver.h. The nozzle limit is also the firmware's PID output
# limit. span_us / limit is the linkage (us per nozzle degree), which with
# the servo speed below sets how fast the nozzle can move on that axis.
# lever is that axis's gimbal pivot -> CoM distance at liftoff (CAD): the two
# gimbal rings pivot at different heights, so the axes get different leverage.
AXES = {
    "pitch": dict(limit=7.0,  span_us=510, lever=0.14061),   # nozzle along Z, servo on pin 6 (Z arm)
    "yaw":   dict(limit=10.0, span_us=215, lever=0.18261),   # nozzle along X, servo on pin 5 (X arm)
}

# --- Servo / actuator ---
PIDDT = 0.008                       # s       controller period (firmware's 125 Hz loop)
SERVO_REFRESH_HZ = 50               # Hz      Teensy Servo.h sends a new pulse every 20 ms,
                                    #         so the servo's target only changes that often
servoDelay = 0.005                  # s       pulse -> motion delay inside the servo
# Servo speed — ESTIMATE until you have the datasheet figure. Hobby servos are
# specced in seconds per 60 deg of horn travel (0.08-0.20 typical) and turn
# roughly 0.1 deg of horn per us of pulse.
servoSecPer60 = 0.12                # s / 60 deg
servoHornDegPerUs = 0.10            # deg / us
TVCBias = 0.0                       # deg     constant nozzle misalignment
TVCNoiseAmplitude = 1.5             # deg     nozzle pointing error (deadband, linkage slop),
                                    #         re-drawn each time the servo gets a new pulse

# --- Sensor (the firmware's attitude-filter tilt) ---
angleSensorBias = 0.0               # deg
# The firmware steers by the attitude filter's tilt, which is integrated gyro,
# so sample-to-sample noise is small. ESTIMATE — bench test I prints the tilt
# wander at rest ("wandering X deg p-p"); half of that is a conservative value.
angleSensorNoiseAmplitude = 0.05    # deg

# --- Simulation parameters ---
dt = 0.001                          # s       physics step — divides the 8 ms PID and
                                    #         20 ms servo periods exactly
simLength = 7.0                     # s
initAngle = 5.0                     # deg     (initial pitch disturbance)
initSetpoint = 0.0                  # deg
finalSetpoint = 0.0                 # deg
timeToFinalSetpoint = 0.0           # s       (ramp end time; 0 = step)

# --- Environment ---
useThrustCurve = True               # True = Estes F-15, False = constant `thrustValue`
thrustValue = 15.0                  # N (used only if useThrustCurve = False)
windFx = 0.0                        # N (steady crosswind force)
windGustFx = 0.0                    # N (peak gust magnitude, randomized)
airDensity = 1.225                  # kg/m^3
gravity = 9.81                      # m/s^2

# --- Reproducibility ---
randomSeed = 42                     # set to None for different noise each run

# --- Plotting ---
focusOnPoweredPhase = True          # True = zoom plots to burn time + 0.5s coast (best for PID tuning)

# ============================================================================
# Estes F-15 thrust curve — full certified RASP data from thrustcurve.org
# (motor id 5f4294d200023100000003f2, cert source). Burn time 3.45 s, total
# impulse 49.61 N*s. The old table here stopped at t=1.736s / 0 N, which was
# only the first third of the real curve (real thrust at 1.736s is ~14.6 N,
# not 0) — that truncation was why PID gains tuned against this sim didn't
# carry over to the firmware, which sees the motor's full ~3.45 s burn.
# ============================================================================
F15_CURVE = np.array([
    [0.000,  0.000],
    [0.148,  7.638],
    [0.228, 12.253],
    [0.294, 16.391],
    [0.353, 20.210],
    [0.382, 22.756],
    [0.419, 25.260],
    [0.477, 23.074],
    [0.520, 20.845],
    [0.593, 19.093],
    [0.688, 17.500],
    [0.855, 16.225],
    [1.037, 15.427],
    [1.205, 14.948],
    [1.423, 14.627],
    [1.452, 15.741],
    [1.503, 14.785],
    [1.736, 14.623],
    [1.955, 14.303],
    [2.210, 14.141],
    [2.494, 13.819],
    [2.763, 13.338],
    [3.120, 13.334],
    [3.382, 13.013],
    [3.404,  9.352],
    [3.418,  4.895],
    [3.450,  0.000],
])
_trapezoid = getattr(np, "trapezoid", None) or np.trapz   # trapz was removed in numpy 2
F15_TOTAL_IMPULSE = float(_trapezoid(F15_CURVE[:, 1], F15_CURVE[:, 0]))   # N*s, ~49.6

def getThrust(t):
    """Thrust (N) at time t (s)."""
    if not useThrustCurve:
        return thrustValue if t < simLength else 0.0
    if t <= 0.0 or t >= F15_CURVE[-1, 0]:
        return 0.0
    return float(np.interp(t, F15_CURVE[:, 0], F15_CURVE[:, 1]))


# Cumulative impulse at each curve breakpoint, for propellantRemainingFrac()
# below — precomputed once rather than re-integrating from t=0 every call.
_F15_CUM_IMPULSE = np.concatenate((
    [0.0],
    np.cumsum(0.5 * (F15_CURVE[1:, 1] + F15_CURVE[:-1, 1]) * np.diff(F15_CURVE[:, 0]))
))


def propellantRemainingFrac(t):
    """Fraction (1.0 -> 0.0) of propellant mass remaining at time t (s).

    Assumes propellant burns proportional to delivered impulse — the
    standard approximation absent real grain-geometry data. Only used
    when useThrustCurve is True; a constant-thrust motor has no impulse
    curve to derive this from, so mass is held constant in that mode.
    """
    if not useThrustCurve or t <= 0.0:
        return 1.0
    if t >= F15_CURVE[-1, 0]:
        return 0.0
    cum_impulse = float(np.interp(t, F15_CURVE[:, 0], _F15_CUM_IMPULSE))
    return max(0.0, 1.0 - cum_impulse / F15_TOTAL_IMPULSE)


# ============================================================================
# Simulation
# ============================================================================

def run(axis):
    """Simulate one TVC axis ("pitch" or "yaw" from AXES) with the shared gains."""
    if randomSeed is not None:
        random.seed(randomSeed)
        np.random.seed(randomSeed)

    limit      = AXES[axis]["limit"]                        # nozzle deg = PID output limit
    i_limit    = min(integralLimit, limit)                  # as pid_init() caps it
    us_per_deg = AXES[axis]["span_us"] / limit              # linkage
    slew       = (60.0 / servoSecPer60) / servoHornDegPerUs / us_per_deg   # nozzle deg/s

    # --- Solve the fixed dry-airframe CG and propellant CG positions
    # (both measured as a distance from the nozzle, "forward" = larger)
    # that combine to this axis's liftoff lever arm, given
    # propellant sits propellantCgOffsetAftOfCOM behind the liftoff CG.
    # Both positions are then fixed for the whole flight; only how much
    # propellant mass remains at the propellant position changes.
    dryMass = mass - propellantMass
    x_combined_liftoff = AXES[axis]["lever"]
    x_propellant = x_combined_liftoff - propellantCgOffsetAftOfCOM
    x_dry = (x_combined_liftoff * mass - propellantMass * x_propellant) / dryMass

    steps = int(simLength / dt)
    pid_every     = max(1, round(PIDDT / dt))
    refresh_every = max(1, round(1.0 / SERVO_REFRESH_HZ / dt))
    delaySteps    = round(servoDelay / dt)

    # State histories
    t        = np.zeros(steps)
    theta    = np.zeros(steps)   # true rocket pitch (deg)
    omega    = np.zeros(steps)   # angular velocity (deg/s)
    alpha_a  = np.zeros(steps)   # angular accel (deg/s^2)

    thetaMeas    = np.zeros(steps)   # tilt the controller sees
    tvcCmd       = np.zeros(steps)   # PID output before the output clamp
    tvcCmdLim    = np.zeros(steps)   # servo target: clamped, held between 20 ms pulses
    tvcActual    = np.zeros(steps)   # where the nozzle points (delay, servo speed, error, bias)
    setpoint_hist = np.zeros(steps)

    altitude = np.zeros(steps)
    vz       = np.zeros(steps)
    vx       = np.zeros(steps)
    x_pos    = np.zeros(steps)
    thrust_hist = np.zeros(steps)
    fx_hist     = np.zeros(steps)  # lateral force on rocket

    # Initial conditions
    theta[0] = initAngle

    # PID state (integral holds the i-term, ki already applied, as in pid.cpp)
    integral = 0.0
    prev_err = initSetpoint - (initAngle + angleSensorBias)
    d_filt = 0.0
    pid_output = 0.0

    # Servo state
    servo_target = 0.0
    point_err = 0.0
    nozzle = 0.0

    for i in range(steps - 1):
        t[i] = i * dt
        now = t[i]

        # --- Setpoint (ramp from init to final) ---
        if timeToFinalSetpoint <= 0.0 or now >= timeToFinalSetpoint:
            sp = finalSetpoint
        else:
            sp = initSetpoint + (finalSetpoint - initSetpoint) * (now / timeToFinalSetpoint)
        setpoint_hist[i] = sp

        # --- Sensor: measured angle with bias + noise ---
        thetaMeas[i] = (theta[i]
                        + angleSensorBias
                        + random.uniform(-angleSensorNoiseAmplitude,
                                          angleSensorNoiseAmplitude))

        # --- PID, as in src/pid.cpp (every PIDDT) ---
        if i % pid_every == 0:
            err = sp - thetaMeas[i]
            d_raw = (err - prev_err) / PIDDT
            d_filt = alpha * d_raw + (1.0 - alpha) * d_filt
            integral += ki * err * PIDDT
            integral = max(-i_limit, min(i_limit, integral))
            pid_output = kp * err + integral + kd * d_filt
            prev_err = err
        tvcCmd[i] = pid_output
        cmd_clamped = max(-limit, min(limit, pid_output))

        # --- Servo: a new pulse (target) only every 20 ms ---
        if i % refresh_every == 0:
            servo_target = cmd_clamped
            point_err = random.uniform(-TVCNoiseAmplitude, TVCNoiseAmplitude)
        tvcCmdLim[i] = servo_target

        # --- Servo delay, then the nozzle moves toward the target at servo speed ---
        target = tvcCmdLim[i - delaySteps] if i >= delaySteps else 0.0
        max_step = slew * dt
        nozzle += max(-max_step, min(max_step, target - nozzle))
        tvcActual[i] = nozzle + TVCBias + point_err

        # --- Dynamics ---
        T = getThrust(now)
        thrust_hist[i] = T

        # Propellant burn-off: recombine dry + remaining-propellant point
        # masses into the instantaneous mass and CG lever arms. MOI is
        # scaled by the mass ratio as a first-order approximation (no
        # parallel-axis correction) — the review calls this a small
        # effect, and this is intentionally not more precise than that.
        remaining_frac = propellantRemainingFrac(now)
        mass_t         = dryMass + propellantMass * remaining_frac
        x_combined_t   = (dryMass * x_dry + propellantMass * remaining_frac * x_propellant) / mass_t
        leverTVC_t     = x_combined_t
        leverCP_t      = distanceCPToCOM - (x_combined_t - x_combined_liftoff)
        MOI_t          = MOI * (mass_t / mass)

        # Thrust component along rocket axis -> vertical accel (simplified, rocket ~ vertical)
        theta_rad = math.radians(theta[i])
        tvc_rad   = math.radians(tvcActual[i])

        # Axial thrust component (along rocket body) and lateral (perp to body)
        T_axial   = T * math.cos(tvc_rad)
        T_lateral = T * math.sin(tvc_rad)

        # Drag on the body (opposes velocity). Use total speed.
        v_total = math.hypot(vx[i], vz[i])
        q = 0.5 * airDensity * v_total * v_total
        drag = q * dragCoefficient * rocketCrossSectionalArea  # N

        # Accelerations in world frame (rocket points ~upward; small angle approximation
        # for world-frame projection is fine for typical TVC tuning scenarios)
        # Vertical:  T_axial*cos(theta) - lateral*sin(theta) - mg - drag_z
        # Horizontal: T_axial*sin(theta) + lateral*cos(theta) + wind - drag_x
        drag_z = drag * (vz[i] / v_total) if v_total > 1e-6 else 0.0
        drag_x = drag * (vx[i] / v_total) if v_total > 1e-6 else 0.0

        gust = random.uniform(-windGustFx, windGustFx) if windGustFx > 0 else 0.0
        Fx_world = (T_axial * math.sin(theta_rad)
                    + T_lateral * math.cos(theta_rad)
                    + windFx + gust - drag_x)
        Fz_world = (T_axial * math.cos(theta_rad)
                    - T_lateral * math.sin(theta_rad)
                    - mass_t * gravity - drag_z)

        fx_hist[i] = Fx_world

        # Translational integration
        vx[i + 1] = vx[i] + (Fx_world / mass_t) * dt
        vz[i + 1] = vz[i] + (Fz_world / mass_t) * dt
        x_pos[i + 1]    = x_pos[i]    + vx[i + 1] * dt
        altitude[i + 1] = altitude[i] + vz[i + 1] * dt

        # Ground impact: freeze everything once we hit the ground (after liftoff).
        if altitude[i + 1] <= 0.0 and altitude[i] > 0.0 and vz[i + 1] < 0.0:
            altitude[i + 1] = 0.0
            vx[i + 1] = 0.0
            vz[i + 1] = 0.0
            # Hold pose from here on
            for k in range(i + 1, steps):
                altitude[k] = 0.0
                vx[k] = 0.0
                vz[k] = 0.0
                x_pos[k] = x_pos[i + 1]
                theta[k] = theta[i + 1] if k > i + 1 else theta[i]
                omega[k] = 0.0
                t[k] = k * dt
            break

        # --- Rotational dynamics ---
        # Moment from TVC: positive tvc angle -> positive torque -> positive theta rate.
        # Classical PID with err = sp - theta then commands negative TVC when theta > sp,
        # producing a restoring torque. Sign convention matches a conventional controller.
        M_tvc = T * math.sin(tvc_rad) * leverTVC_t

        # Aerodynamic moment from normal force at CP.
        # Side force ~ q * A * C_N_alpha * sin(theta) acting at CP.
        # If CP is aft of CoM (stable):   moment is restoring  -> negative sign
        # If CP is fwd of CoM (unstable): moment is destabilizing -> positive sign
        q_dyn = 0.5 * airDensity * (vz[i] * vz[i] + vx[i] * vx[i])
        aero_sign = +1.0 if isAerodynamicallyUnstable else -1.0
        M_aero = aero_sign * q_dyn * rocketCrossSectionalArea * C_N_alpha \
                 * math.sin(theta_rad) * leverCP_t

        M_total = M_tvc + M_aero

        alpha_a[i + 1] = math.degrees(M_total / MOI_t)
        omega[i + 1]   = omega[i] + alpha_a[i + 1] * dt
        theta[i + 1]   = theta[i] + omega[i + 1] * dt

    # last sample
    t[-1] = (steps - 1) * dt
    thetaMeas[-1]    = thetaMeas[-2]
    tvcCmd[-1]       = tvcCmd[-2]
    tvcCmdLim[-1]    = tvcCmdLim[-2]
    tvcActual[-1]    = tvcActual[-2]
    setpoint_hist[-1] = setpoint_hist[-2]
    thrust_hist[-1]  = thrust_hist[-2]

    return {
        'axis': axis, 'limit': limit, 'slew': slew,
        't': t, 'theta': theta, 'omega': omega, 'alpha': alpha_a,
        'thetaMeas': thetaMeas,
        'tvcCmd': tvcCmd, 'tvcCmdLim': tvcCmdLim, 'tvcActual': tvcActual,
        'setpoint': setpoint_hist,
        'altitude': altitude, 'vz': vz, 'vx': vx, 'x': x_pos,
        'thrust': thrust_hist,
    }


# ============================================================================
# Summary + plotting
# ============================================================================

AXIS_COLOR = {"pitch": "#d62728", "yaw": "#1f77b4"}
AXIS_WIDTH = {"pitch": 2.6, "yaw": 1.1}   # pitch drawn wider underneath, so it shows where they overlap


def summarize(r):
    """Stats over powered flight only (when TVC has authority). After burnout
    an unstable rocket will tumble — that's expected, not a tuning problem."""
    powered = r['thrust'] > 0.1
    last = int(np.where(powered)[0][-1]) if powered.any() else len(r['t']) - 1
    t_p, th_p, sp_p = r['t'][:last + 1], r['theta'][:last + 1], r['setpoint'][:last + 1]

    # Settling time: first t where |theta - sp| stays under 5% of initAngle for 0.25 s
    band = 0.05 * max(abs(initAngle), 1.0)
    window = int(0.25 / dt)
    settle = None
    for i in range(len(th_p) - window):
        if np.all(np.abs(th_p[i:i + window] - sp_p[i:i + window]) < band):
            settle = t_p[i]
            break
    return {
        'burn_end':  r['t'][last],
        'max_theta': float(np.abs(th_p).max()),
        'settle':    settle,
        'ss_err':    float(abs(th_p[-1] - sp_p[-1])),
        'sat':       100.0 * float(np.mean(np.abs(r['tvcCmd'][:last + 1]) > r['limit'])),
    }


def describe(r, s):
    settle = 'n/a' if s['settle'] is None else f"{s['settle']:.2f}s"
    return (f"{r['axis']:<5} (+/-{r['limit']:g} deg, nozzle up to {r['slew']:.0f} deg/s): "
            f"max tilt {s['max_theta']:.2f} deg   settle {settle}   "
            f"ss err {s['ss_err']:.2f} deg   saturation {s['sat']:.1f}%")


def plot(runs):
    fig = plt.figure('TVC Simulator - PID Tuning', figsize=(13, 8.5))
    g = plt.GridSpec(3, 2, hspace=0.5, wspace=0.25, top=0.86)
    axs = [fig.add_subplot(g[row, col]) for row in range(3) for col in range(2)]
    # axs[0]=tilt, [1]=nozzle, [2]=omega, [3]=thrust, [4]=altitude/vz, [5]=trajectory

    for r in runs:
        c, w, name = AXIS_COLOR[r['axis']], AXIS_WIDTH[r['axis']], r['axis']
        axs[0].plot(r['t'], r['theta'],     color=c, linewidth=w, label=f'{name} true')
        axs[0].plot(r['t'], r['thetaMeas'], color=c, linewidth=0.6, alpha=0.4, label=f'{name} measured')
        axs[1].plot(r['t'], r['tvcCmd'],    color=c, linewidth=0.7, alpha=0.5, linestyle='--',
                    label=f'{name} PID command')
        axs[1].plot(r['t'], r['tvcActual'], color=c, linewidth=w, label=f'{name} nozzle')
        for lim in (r['limit'], -r['limit']):
            axs[1].axhline(lim, color=c, linestyle=':', linewidth=0.8)
        axs[2].plot(r['t'], r['omega'], color=c, linewidth=w, label=name)
        axs[4].plot(r['t'], r['altitude'], color=c, linewidth=w, label=f'{name} altitude')
        axs[4].plot(r['t'], r['vz'],       color=c, linewidth=w, linestyle='--', label=f'{name} V_z')
        axs[5].plot(r['x'], r['altitude'], color=c, linewidth=w, label=name)
    axs[0].plot(runs[0]['t'], runs[0]['setpoint'], color='black', linewidth=0.8, linestyle='--',
                label='setpoint')
    axs[3].plot(runs[0]['t'], runs[0]['thrust'], color='#2ca02c')

    titles = [('Rocket Tilt', 'angle (deg)'), ('Nozzle Angle', 'angle (deg)'),
              ('Angular Velocity', 'deg/s'), ('Thrust', 'N'),
              ('Altitude & Vertical Speed', 'm  /  m/s'), ('Trajectory (x vs altitude)', 'altitude (m)')]
    for ax_, (title, ylabel) in zip(axs, titles):
        ax_.set_title(title)
        ax_.set_ylabel(ylabel)
        ax_.set_xlabel('x (m)' if ax_ is axs[5] else 'time (s)')
        ax_.grid(alpha=0.3)
    for ax_ in (axs[0], axs[1], axs[2], axs[4], axs[5]):
        ax_.legend(loc='best', fontsize=7)
    axs[5].set_aspect('equal', adjustable='datalim')

    stats = [summarize(r) for r in runs]
    burn_end_t = stats[0]['burn_end']

    # Shade the coast phase on the time plots
    for ax_ in axs[:5]:
        ax_.axvspan(burn_end_t, runs[0]['t'][-1], color='gray', alpha=0.08, zorder=0)

    # Optionally zoom the time plots to powered phase + a short coast tail,
    # re-fitting y to what's visible. The trajectory plot has no time axis.
    if focusOnPoweredPhase:
        x_max = burn_end_t + 0.5
        end_idx = min(int(x_max / dt) + 1, len(runs[0]['t']))
        def _yfit(ax_, keys):
            allvals = np.concatenate([r[k][:end_idx] for r in runs for k in keys])
            lo, hi = float(np.min(allvals)), float(np.max(allvals))
            pad = max(0.1, 0.1 * (hi - lo))
            ax_.set_ylim(lo - pad, hi + pad)
        for ax_ in axs[:5]:
            ax_.set_xlim(0, x_max)
        _yfit(axs[0], ('theta', 'thetaMeas', 'setpoint'))
        _yfit(axs[1], ('tvcCmdLim', 'tvcActual'))   # ignore the raw command, which can be huge
        _yfit(axs[2], ('omega',))
        _yfit(axs[3], ('thrust',))
        _yfit(axs[4], ('altitude', 'vz'))

    fig.suptitle(f"kp={kp}  ki={ki}  kd={kd}    |    powered phase 0-{burn_end_t:.2f}s\n"
                 + "\n".join(describe(r, s) for r, s in zip(runs, stats)), fontsize=9)
    plt.show()


if __name__ == '__main__':
    runs = [run(axis) for axis in AXES]
    print(f"kp={kp}  ki={ki}  kd={kd}  (powered phase)")
    for r in runs:
        print("  " + describe(r, summarize(r)))
    plot(runs)